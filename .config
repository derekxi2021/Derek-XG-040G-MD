# OpenWRt 编译配置
CONFIG_MODULES=y
CONFIG_HAVE_DOT_CONFIG=y
CONFIG_HOST_OS_LINUX=y

# 目标芯片平台与型号 (Airoha AN7581 / Nokia XG-040G-MD)
CONFIG_TARGET_airoha=y
CONFIG_TARGET_airoha_an7581=y
CONFIG_TARGET_airoha_an7581_DEVICE_nokia_xg-040g-md=y
CONFIG_HAS_SUBTARGETS=y
CONFIG_HAS_DEVICES=y
CONFIG_TARGET_BOARD="airoha"
CONFIG_TARGET_SUBTARGET="an7581"
CONFIG_TARGET_PROFILE="DEVICE_nokia_xg-040g-md"
CONFIG_TARGET_ARCH_PACKAGES="aarch64_cortex-a53"
CONFIG_DEFAULT_TARGET_OPTIMIZATION="-Os -pipe -mcpu=cortex-a53"
CONFIG_CPU_TYPE="cortex-a53"
CONFIG_LINUX_6_12=y

#
# Boot Loaders
#
# CONFIG_PACKAGE_u-boot-an7581_gemtek_w1700k is not set
# CONFIG_PACKAGE_u-boot-an7581_nokia_valyrian is not set
# CONFIG_PACKAGE_u-boot-an7581_nokia_xg-040g-md=y
# CONFIG_PACKAGE_u-boot-an7581_rfb is not set
# end of Boot Loaders

# 默认预装组件与驱动
CONFIG_DEFAULT_airoha-en7581-npu-firmware=y
CONFIG_DEFAULT_base-files=y
# 磁盘 UUID 识别
CONFIG_DEFAULT_blkid=y
CONFIG_DEFAULT_ca-bundle=y
# DNS/DHCP 服务 (完整版)
CONFIG_DEFAULT_dnsmasq-full=y
# 轻量 SSH 服务
CONFIG_DEFAULT_dropbear=y
# nftables 防火墙 (fw4)
CONFIG_DEFAULT_firewall4=y
CONFIG_DEFAULT_fstools=y
CONFIG_DEFAULT_kmod-gpio-button-hotplug=y
CONFIG_DEFAULT_kmod-i2c-an7581=y
CONFIG_DEFAULT_kmod-leds-gpio=y
# nftables 硬件加速
CONFIG_DEFAULT_kmod-nft-offload=y
# Airoha EN8811H PHY 驱动
CONFIG_DEFAULT_kmod-phy-airoha-en8811h=y
# USB UAS 高速存储驱动
CONFIG_DEFAULT_kmod-usb-storage-uas=y
CONFIG_DEFAULT_libc=y
CONFIG_DEFAULT_libgcc=y
CONFIG_DEFAULT_libustream-openssl=y
CONFIG_DEFAULT_logd=y
CONFIG_DEFAULT_lsblk=y
# Flash MTD 操作工具
CONFIG_DEFAULT_mtd=y
CONFIG_DEFAULT_netifd=y
CONFIG_DEFAULT_nftables=y
CONFIG_DEFAULT_odhcp6c=y
CONFIG_DEFAULT_odhcpd-ipv6only=y
