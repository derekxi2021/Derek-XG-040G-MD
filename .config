# ==============================================================================
# OpenWrt .config - Optimized for AN7581 (Nokia/Bell XG-040G-MD)
# 基于主线 Linux 6.12 / fw4 / APK 包管理器
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 目标芯片平台与设备 Profile
# ------------------------------------------------------------------------------
CONFIG_TARGET_airoha=y
CONFIG_TARGET_airoha_an7581=y
CONFIG_TARGET_airoha_an7581_DEVICE_nokia_xg-040g-md=y
CONFIG_TARGET_airoha_an7581_DEVICE_nokia_xg-040g-md-ubi=y
CONFIG_ARCH_64BIT=y
CONFIG_aarch64=y
CONFIG_LINUX_6_12=y

# ------------------------------------------------------------------------------
# 2. AN7581 硬件专有驱动、NPU 加速与温度监控 (吸收配置 2)
# ------------------------------------------------------------------------------
CONFIG_PACKAGE_airoha-en7581-npu-firmware=y
CONFIG_PACKAGE_luci-app-airoha-npu=y
CONFIG_PACKAGE_kmod-phy-airoha-en8811h=y
CONFIG_PACKAGE_kmod-i2c-an7581=y
CONFIG_PACKAGE_kmod-thermal-an7581=y
CONFIG_PACKAGE_kmod-hwmon-core=y
CONFIG_PACKAGE_kmod-thermal=y
CONFIG_PACKAGE_kmod-hwmon-vid=y
CONFIG_PACKAGE_lm-sensors=y
CONFIG_PACKAGE_lm-sensors-user=y
CONFIG_PACKAGE_luci-i18n-airoha-npu-zh-cn=y


# ------------------------------------------------------------------------------
# 3. 基础系统与包管理器 (APK)
# ------------------------------------------------------------------------------
CONFIG_DEFAULT_base-files=y
CONFIG_DEFAULT_dnsmasq-full=y
CONFIG_DEFAULT_firewall4=y
CONFIG_DEFAULT_dropbear=y
CONFIG_PACKAGE_openssh-sftp-server=y
CONFIG_PACKAGE_apk-openssl=y
CONFIG_USE_APK=y
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-opkg-zh-cn=y

# ------------------------------------------------------------------------------
# 4. 网络底层与透明代理加速 (nftables + TProxy) (吸收配置 2)
# ------------------------------------------------------------------------------
CONFIG_IPV6=y
CONFIG_PACKAGE_nftables=y
CONFIG_PACKAGE_iptables-nft=y
CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-nf-socket=y
CONFIG_PACKAGE_kmod-macvlan=y
CONFIG_PACKAGE_kmod-tcp-bbr=y

# ------------------------------------------------------------------------------
# 5. USB 存储、磁盘格式与 SMART 健康监控 (配合 Samba4 / 吸收配置 2)
# ------------------------------------------------------------------------------
CONFIG_USB_SUPPORT=y
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-xhci-mtk=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_blkid=y
CONFIG_PACKAGE_lsblk=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_dosfstools=y
#CONFIG_PACKAGE_smartmontools=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fuse=y
CONFIG_PACKAGE_ntfs-3g=y
CONFIG_PACKAGE_kmod-nls-utf8=y

# ------------------------------------------------------------------------------
# 6. LuCI 界面与主题
# ------------------------------------------------------------------------------
CONFIG_PACKAGE_uhttpd=y
CONFIG_PACKAGE_luci=y
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-theme-bootstrap=y

# ------------------------------------------------------------------------------
# 7. 核心应用组件
# ------------------------------------------------------------------------------
# 7.1 科学上网: PassWall2 + Sing-Box
CONFIG_PACKAGE_sing-box=y
CONFIG_PACKAGE_luci-app-passwall2=y
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Haproxy=y
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_ShadowsocksR_Libev_Client=y
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_ShadowsocksR_Libev_Server=y
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_SingBox=y
CONFIG_PACKAGE_luci-i18n-passwall2-zh-cn=y

# 7.2 Samba4 局域网共享
#CONFIG_PACKAGE_samba4-server=y
#CONFIG_PACKAGE_luci-app-samba4=y
#CONFIG_PACKAGE_autosamba=y
#CONFIG_PACKAGE_luci-i18n-samba4-zh-cn=y

# 7.3 WireGuard 组网
CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_SING_BOX_WITH_WIREGUARD=y
CONFIG_PACKAGE_luci-proto-wireguard=y
CONFIG_PACKAGE_luci-i18n-wireguard-zh-cn=y

# 7.4 TurboACC 网络加速
#CONFIG_PACKAGE_luci-app-turboacc=y
#CONFIG_PACKAGE_TURBOACC_INCLUDE_FLOW_OFFLOADING=y
#CONFIG_PACKAGE_TURBOACC_INCLUDE_FAST_CLASSIFIER=y
#CONFIG_PACKAGE_TURBOACC_INCLUDE_SHORTCUT_FE_CM=y
#CONFIG_PACKAGE_TURBOACC_INCLUDE_BBR_CCA=y
#CONFIG_PACKAGE_luci-i18n-turboacc-zh-cn=y

# 7.5 UPnP / DDNS / WOL / VLMCSD
CONFIG_PACKAGE_miniupnpd=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y
CONFIG_PACKAGE_vlmcsd=y
CONFIG_PACKAGE_luci-app-vlmcsd=y
CONFIG_PACKAGE_luci-i18n-vlmcsd-zh-cn=y
CONFIG_PACKAGE_ddns-scripts=y
CONFIG_PACKAGE_ddns-scripts-cloudflare=y
CONFIG_PACKAGE_ddns-scripts-services=y
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_luci-i18n-ddns-zh-cn=y
#CONFIG_PACKAGE_perl=y
CONFIG_PACKAGE_wakeonlan=y
CONFIG_PACKAGE_etherwake=y
CONFIG_PACKAGE_luci-app-wol=y
CONFIG_PACKAGE_luci-i18n-wol-zh-cn=y

# ------------------------------------------------------------------------------
# 8. 实用运维与测速工具 (吸收配置 2)
# ------------------------------------------------------------------------------
CONFIG_PACKAGE_curl=y
#CONFIG_PACKAGE_wget-ssl=y
#CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_htop=y

# ------------------------------------------------------------------------------
# 9. UBI & UBIFS 闪存文件系统支持
# ------------------------------------------------------------------------------
# 内核层级的 UBI / UBIFS 驱动支持
CONFIG_KERNEL_UBIFS_FS=y
CONFIG_KERNEL_UBIFS_FS_ADVANCED=y
#CONFIG_KERNEL_GZIP=y
#CONFIG_KERNEL_UBIFS_FS_LZO=y
CONFIG_KERNEL_UBIFS_FS_ZLIB=y
#CONFIG_KERNEL_UBIFS_FS_ZSTD=y

# 用户态 UBI 管理工具（用于终端下查看、格式化、挂载 UBI 卷）
CONFIG_PACKAGE_ubi-utils=y

# Target 镜像生成（生成 .ubi / .ubifs 格式的刷机固件）
CONFIG_TARGET_ROOTFS_UBIFS=y
CONFIG_TARGET_UBIFS_FREE_SPACE_FIXUP=y

# itb文件生成
CONFIG_TARGET_ROOTFS_SQUASHFS=y
#CONFIG_TARGET_ROOTFS_INITRAMFS=y
#CONFIG_TARGET_INITRAMFS_COMPRESSION_NONE=y

# 补齐 FIT 镜像校验工具
#CONFIG_PACKAGE_fit-check-image=y
CONFIG_PACKAGE_uboot-envtools=y
